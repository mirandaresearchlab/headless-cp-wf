// Slurm profile: `-profile slurm,apptainer --slurm_account <account>`
// Every site-specific value is a parameter (see nextflow.config). Check your cluster's
// documentation for the account, partition, per-user job limits and node-local scratch.
//
// The process settings are closures: Nextflow evaluates them per task, after every config
// file is read. So the parameters also work when they are set in a `-c site.config` file.

// The core budget of the run on the cluster: 200 cores = 100 analysis chunks of 2 cores at once.
// Change it with --total_cpus (on the command line or in the params file); respect the site's per-user limit.
params {
    total_cpus = 200
}

// How Nextflow talks to Slurm: how many jobs it keeps in the queue, and how often it submits and checks jobs.
// queueSize = --total_cpus / --segmentation_cpus: no more jobs than that are queued or running at once.
executor {
    name              = 'slurm'
    queueSize         = Math.max(1, (params.total_cpus as int).intdiv(params.segmentation_cpus as int))
    submitRateLimit   = '20/1min'                 // do not overload the Slurm controller
    pollInterval      = '30 sec'
    queueStatInterval = '2 min'
    exitReadTimeout   = '5 min'                   // shared filesystems can be slow to show .exitcode files
}

// What each job asks Slurm for: the partition (queue), the account, and the folder that the job works in.
process {
    executor       = 'slurm'
    queue          = { params.slurm_partition ?: null }     // null = the cluster's default partition
    clusterOptions = { [params.slurm_account ? "--account=${params.slurm_account}" : '',
                        params.slurm_cluster_options ?: ''].join(' ').trim() }

    // Node-local scratch: set --slurm_scratch '$TMPDIR' (or the site's variable) if nodes have a local disk.
    // Off by default: some clusters have diskless nodes, where scratch would use RAM.
    // `--slurm_scratch false` arrives as the text 'false': treat it as off, not as a folder name.
    scratch        = { params.slurm_scratch && !(params.slurm_scratch.toString() in ['false', 'no', '0']) ? params.slurm_scratch : false }
    stageOutMode   = 'rsync'
}
