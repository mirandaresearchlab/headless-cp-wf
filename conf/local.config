/*
 * Profile 'local': run every task on this computer.
 * The tasks share a budget of --total_cpus and --total_memory.
 */

process {
    executor = 'local'

    // A retry asks for more memory and time (conf/base.config), but never more than the budget.
    resourceLimits = [cpus: params.total_cpus as Integer, memory: params.total_memory as MemoryUnit]

    // 0 means no limit per process. The total budget below still applies.
    maxForks = params.max_forks as Integer

    // With --segmentation gpu, one SEGMENT task at a time: its workers share the GPU.
    withName: SEGMENT {
        maxForks = params.segmentation == 'gpu' ? 1 : (params.max_forks as Integer)
    }
}

executor {
    cpus = params.total_cpus as Integer
    memory = params.total_memory as MemoryUnit
    submitRateLimit = '10 sec'
}

workDir = params.nf_work_dir ?: "${launchDir}/work"
