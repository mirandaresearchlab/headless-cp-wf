/*
 * Profile 'local': run every task on this computer.
 * The tasks share a budget of --total_cpus and --total_memory.
 */

process {
    executor = 'local'

    // 0 means no limit per process. The total budget below still applies.
    maxForks = params.max_forks as int
}

executor {
    cpus = params.total_cpus as int
    memory = params.total_memory as MemoryUnit
    submitRateLimit = '10 sec'
}

workDir = params.nf_work_dir ?: "${launchDir}/work"
