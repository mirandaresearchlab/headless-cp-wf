/*
 * Process settings that every profile shares.
 */

process {
    cpus = params.task_cpus as int
    memory = params.task_memory as MemoryUnit
    time = params.task_time as Duration
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Exit codes 137 and 143 mean that the system stopped the task (for example, out of memory).
    // Retry those. Any other error stops the run, because it means a wrong input or a failed check.
    errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
    maxRetries = params.max_retries as int
    maxErrors = 10

    // SEGMENT runs segmentation_workers CellProfiler processes: one core and task_memory each.
    // The Berzelius profile gives a GPU task the cores and memory of one GPU instead.
    withName: 'SEGMENT' {
        cpus = params.segmentation_workers as int
        memory = (params.task_memory as MemoryUnit) * (params.segmentation_workers as int)
    }
}

// Keep the work files after the run, for -resume and for debugging.
cleanup = false
