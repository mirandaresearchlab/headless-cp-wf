/*
 * Process settings that every profile shares.
 */

process {
    cpus = params.task_cpus as Integer
    // Each retry asks for more: attempt 2 gets 2x task_memory and 2x task_time, attempt 3 gets 3x.
    // The profiles set resourceLimits, so a retry never asks for more than the executor can give.
    memory = { (params.task_memory as MemoryUnit) * task.attempt }
    time = { (params.task_time as Duration) * task.attempt }
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Exit codes 137, 140 and 143 mean that the system stopped the task: out of memory (137),
    // the Slurm time limit (140), or a cancel (143). Retry those with more memory and time.
    // Any other error stops the run, because it means a wrong input or a failed check.
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries = params.max_retries as Integer
    maxErrors = 10

    // SEGMENT runs segmentation_workers CellProfiler processes: one core and task_memory each.
    // The Berzelius profile gives a GPU task the cores and memory of one GPU instead.
    withName: SEGMENT {
        cpus = params.segmentation_workers as Integer
        memory = { (params.task_memory as MemoryUnit) * (params.segmentation_workers as Integer) * task.attempt }
    }
}

// Keep the work files after the run, for -resume and for debugging.
cleanup = false
