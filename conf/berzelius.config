/*
 * Profile 'berzelius': submit every task as its own Slurm job on the Berzelius CPU nodes.
 * With --segmentation gpu, SEGMENT tasks go to the GPU partition instead, one GPU each.
 * Run Nextflow itself in a small head job (see scripts/berzelius-run.sbatch).
 */

params {
    max_retries = 2
}

process {
    executor = 'slurm'
    queue = params.slurm_partition
    clusterOptions = params.slurm_account ? "--account=${params.slurm_account}" : ''

    // A GPU task gets the cores and memory that belong to one GPU, so it sets no --mem.
    // Only SEGMENT uses the GPU; ANALYSIS (the measurements) stays on the CPU nodes.
    withName: SEGMENT {
        queue = params.segmentation == 'gpu' ? params.gpu_partition : params.slurm_partition
        clusterOptions = "${params.slurm_account ? "--account=${params.slurm_account}" : ''} ${params.segmentation == 'gpu' ? '--gpus=1' : ''}".trim()
        cpus = params.segmentation == 'gpu' ? (params.gpu_cpus as Integer) : (params.segmentation_workers as Integer)
        memory = params.segmentation == 'gpu' ? null : (params.task_memory as MemoryUnit) * (params.segmentation_workers as Integer)
        maxForks = params.segmentation == 'gpu' ? (params.max_gpus as Integer) : 0
    }
}

executor {
    // At most max_jobs tasks in the Slurm queue at the same time.
    queueSize = params.max_jobs as Integer
    submitRateLimit = '2 sec'
    pollInterval = '30 sec' as Duration
}

// The compute nodes must see the work folder, so it must be on shared storage.
workDir = {
    if (!params.shared_dir && !params.nf_work_dir) {
        throw new IllegalArgumentException('Berzelius requires --shared_dir or --nf_work_dir')
    }
    return params.nf_work_dir ?: "${params.shared_dir}/nextflow-work"
}.call()
