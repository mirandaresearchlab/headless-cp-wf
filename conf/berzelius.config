// Berzelius (NSC/NAISS, Linköping): `-profile berzelius`. The guide is docs/how-to/run-on-berzelius.md.
// Loaded after conf/slurm.config, so the Slurm account, partition and scratch settings come from there.
//
// Berzelius is a GPU cluster, but CellProfiler uses only CPUs. Every task goes to a CPU partition:
// berzelius-cpu (Ampere system) or berzelius-hopper-cpu (Hopper system). main.nf stops the run for any
// other partition, so no task can hold (and be charged for) an idle GPU.
// Facts checked on 2026-10-14 against https://hpc.pages.naiss.se/user-documentation/berzelius-docs/

// Defaults for Berzelius. Values from the command line or a params file still replace them.
params {

    // CPU node: 128 cores, 1.1 TB RAM, 6.4 TB local NVMe at /scratch/local (erased after each job).
    slurm_scratch  = '/scratch/local'
    max_cpus       = 16
    max_memory     = '112.GB'     // 16 cores x 7 GB
    max_time       = '72.h'       // Berzelius maximum wall time per job

    // Memory comes with the cores (about 7.7 GB per core), and Slurm charges per core: give each core of an
    // analysis chunk 7 GB (14 GB at 2 cores). More than 7 GB per core makes Slurm allocate more cores.
    memory_per_cpu = '7.GB'

    // Only 8 CPU nodes per system, shared by all projects: 64 cores = 32 chunks of 2 cores at once.
    // Ask the other users of your project before you raise it.
    total_cpus     = 64
}

executor {

    // queueSize = --total_cpus / --segmentation_cpus (here again, after the Berzelius value of total_cpus).
    queueSize       = Math.max(1, (params.total_cpus as int).intdiv(params.segmentation_cpus as int))
    submitRateLimit = '10/1min'
}

process {

    // Slurm charges one unit per allocated core (16 cores = 1 A100 GPU-hour on Ampere). Memory comes
    // with cores at about 7.7 GB per core. Ask for at most 7 GB per core: more memory makes Slurm
    // allocate (and charge) more cores. Cores and memory both grow on each retry.
    withLabel: 'cellprofiler' {
        cpus   = { 1 * task.attempt }
        memory = { 7.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withName: 'PATCH_PIPELINE' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }

    // ILLUM: one job per plate. 1 core and 7 GB; cores and memory double on each new try.
    withName: 'ILLUM' {
        cpus   = { 1 * (2 ** (task.attempt - 1)) }
        memory = { 7.GB * (2 ** (task.attempt - 1)) }
        time   = { 4.h * task.attempt }
    }

    // CELLPROFILER: one job per chunk, --segmentation_cpus cores with 7 GB each (--memory_per_cpu).
    // Cores and memory double on each new try, so the job keeps 7 GB per core.
    withName: 'CELLPROFILER' {
        cpus   = { (params.segmentation_cpus as int) * (2 ** (task.attempt - 1)) }
        memory = { (params.memory_per_cpu as nextflow.util.MemoryUnit) * (params.segmentation_cpus as int) * (2 ** (task.attempt - 1)) }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'merge' {
        cpus   = { 1 * task.attempt }
        memory = { 7.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
}

// Docker is not supported on Berzelius. /proj, /scratch, /tmp, $HOME and the working directory are
// bound by default. Keep the image cache in /proj (--container_cache): $HOME has a 20 GB quota.
docker.enabled = false
apptainer {
    enabled     = true
    autoMounts  = true
    cacheDir    = params.container_cache
    pullTimeout = '60 min'        // the CellProfiler image is large, and converting it to SIF is slow
}
