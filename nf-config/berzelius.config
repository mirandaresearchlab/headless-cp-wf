/*
 * Berzelius HPC — Nextflow Configuration
 *
 * Workflow: Headless CellProfiler
 * Executor: SLURM
 * Environment: Conda
 *
 * Compatible with Nextflow 25.10.x
 *
 * All adjustable settings can be overridden using
 * Nextflow CLI parameters (--parameter value).
 */

// --------------------------------------------------
// 1. USER-CONFIGURABLE PARAMETERS
// --------------------------------------------------

params {
    // SLURM allocation
    slurm_partition = 'berzelius-cpu'
    slurm_account = null

    // Resources per Nextflow task
    task_cpus = 1
    task_memory = '6 GB'
    task_time = '4h'

    // Scheduling
    max_jobs = 8

    // Shared storage
    shared_dir = null

    // Optional explicit paths
    nf_work_dir = null
    conda_cache = null

    // Retry policy
    max_retries = 2
}


// --------------------------------------------------
// 2. VALIDATION
// --------------------------------------------------

// Required storage paths are checked when their configuration values are resolved.

// --------------------------------------------------
// 3. SLURM PROCESS CONFIGURATION
// --------------------------------------------------

process {
    executor = 'slurm'

    queue = params.slurm_partition

    cpus = params.task_cpus as int
    memory = params.task_memory
    time = params.task_time

    // Explicit project account, when supplied.
    clusterOptions = params.slurm_account
        ? "--account=${params.slurm_account}"
        : ''

    // Retry transient failures.
    errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }

    maxRetries = params.max_retries as int

    // Prevent excessive retries across the workflow.
    maxErrors = 10
}


// --------------------------------------------------
// 4. SLURM EXECUTOR
// --------------------------------------------------

executor {
    // Maximum submitted/active tasks managed by Nextflow.
    queueSize = params.max_jobs as int

    // Avoid overwhelming SLURM with submissions.
    submitRateLimit = '2 sec'

    // Polling interval for task status.
    pollInterval = '30 sec'
}


// --------------------------------------------------
// 5. CONDA ENVIRONMENTS
// --------------------------------------------------

conda {
    enabled = true

    cacheDir = {
        if (!params.shared_dir && !params.conda_cache) {
            throw new IllegalArgumentException('Berzelius requires --shared_dir or --conda_cache')
        }
        return params.conda_cache ?: "${params.shared_dir}/conda-cache"
    }.call()
}

// Avoid accidentally mixing runtimes.
docker.enabled = false
singularity.enabled = false
apptainer.enabled = false


// --------------------------------------------------
// 6. SHARED WORK DIRECTORY
// --------------------------------------------------

workDir = {
    if (!params.shared_dir && !params.nf_work_dir) {
        throw new IllegalArgumentException('Berzelius requires --shared_dir or --nf_work_dir')
    }
    return params.nf_work_dir ?: "${params.shared_dir}/nextflow-work"
}.call()

// Preserve work directories for debugging and resume.
cleanup = false


// --------------------------------------------------
// 7. EXECUTION REPORTS
// --------------------------------------------------

trace {
    enabled = true
    file = params.project ? "${params.outdir}/projects/${params.project}/report/trace.txt" : "${launchDir}/trace.txt"
    overwrite = true

    fields = ['task_id', 'hash', 'name', 'status', 'exit', 'cpus', 'memory', 'realtime', 'peak_rss', 'peak_vmem', 'read_bytes', 'write_bytes']
}

report {
    enabled = true
    file = params.project ? "${params.outdir}/projects/${params.project}/report/report.html" : "${launchDir}/report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = params.project ? "${params.outdir}/projects/${params.project}/report/timeline.html" : "${launchDir}/timeline.html"
    overwrite = true
}
