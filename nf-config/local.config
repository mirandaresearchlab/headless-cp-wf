/*
 * Local Workstation — Nextflow Configuration
 *
 * Workflow: Headless CellProfiler
 * Executor: Local
 * Environment: Conda
 *
 * Compatible with Nextflow 25.10.x
 *
 * Supports:
 *   - Configurable CPU and memory budgets
 *   - Parallel CellProfiler execution
 *   - Conda environment caching
 *   - Configurable task resources
 *   - Retry handling
 *   - Execution reports
 *   - Resume and debugging
 */

// --------------------------------------------------
// 1. USER-CONFIGURABLE PARAMETERS
// --------------------------------------------------

params {
    // Total resources available to Nextflow.
    total_cpus = 2
    total_memory = '16 GB'

    // Resources requested by each task.
    task_cpus = 1
    task_memory = '6 GB'
    task_time = '4h'

    // Local execution settings.
    max_forks = 0

    // Optional paths.
    nf_work_dir = null
    conda_cache = null

    // Retry policy.
    max_retries = 1
}


// --------------------------------------------------
// 2. LOCAL PROCESS CONFIGURATION
// --------------------------------------------------

process {
    executor = 'local'

    cpus = params.task_cpus as int
    memory = params.task_memory
    time = params.task_time

    // 0 means no additional maxForks limit.
    // The executor resource budget still applies.
    maxForks = params.max_forks as int

    // Retry selected transient failures.
    errorStrategy = {
        task.exitStatus in [137, 143]
            ? 'retry'
            : 'terminate'
    }

    maxRetries = params.max_retries as int

    maxErrors = 10
}


// --------------------------------------------------
// 3. LOCAL EXECUTOR RESOURCE BUDGET
// --------------------------------------------------

executor {
    cpus = params.total_cpus as int
    memory = params.total_memory

    // Controls the rate of task submissions.
    submitRateLimit = '10 sec'
}


// --------------------------------------------------
// 4. CONDA ENVIRONMENTS
// --------------------------------------------------

conda {
    enabled = true

    cacheDir = params.conda_cache ?: "${launchDir}/.nextflow/conda"
}

// Disable container runtimes for this profile.
docker.enabled = false
singularity.enabled = false
apptainer.enabled = false


// --------------------------------------------------
// 5. WORK DIRECTORY
// --------------------------------------------------

workDir = params.nf_work_dir ?: "${launchDir}/work"

// Preserve work files for -resume and debugging.
cleanup = false


// --------------------------------------------------
// 6. EXECUTION REPORTS
// --------------------------------------------------

trace {
    enabled = true
    file = params.project ? "${params.outdir}/projects/${params.project}/report/trace.txt" : "${launchDir}/trace.txt"
    overwrite = true

    fields = ['task_id', 'hash', 'name', 'status', 'exit', 'cpus', 'memory', 'realtime', 'peak_rss', 'peak_vmem', 'read_bytes', 'write_bytes']
}

report {
    enabled = true
    file = params.project ? "${params.outdir}/projects/${params.project}/report/report.html" : "${launchDir}/report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = params.project ? "${params.outdir}/projects/${params.project}/report/timeline.html" : "${launchDir}/timeline.html"
    overwrite = true
}
