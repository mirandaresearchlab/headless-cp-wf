# Settings for cp-headless on Berzelius. The head job and smoke_test.sh read this file with bash.
# Copy it to your project folder, fill it in, and give it to submit.sh with -e.
#   cp scripts/berzelius/berzelius.env.example /proj/<project>/users/$USER/cp-headless.env
# Keep every path in /proj: $HOME has a quota of 20 GB and 1 million files.

PROJ=/proj/<project>/users/$USER

# Nextflow needs Java 17 to 26. Write the exact versions here, so that every run uses the same tools.
# Option A: a site module, if `module avail nextflow` shows one:
#   module load Nextflow/<version>
# Option B: a conda environment in /proj. Make it once in an interactive job:
#   module load Miniforge3/<version>
#   mamba create -p /proj/<project>/users/$USER/envs/nextflow -c conda-forge -c bioconda nextflow=26.04.6 openjdk=21
module load Miniforge3/<version>
eval "$(conda shell.bash hook)"
conda activate "$PROJ/envs/nextflow"

# Nextflow plugins and the container images: in /proj, not in $HOME.
export NXF_HOME="$PROJ/.nextflow"
export NXF_APPTAINER_CACHEDIR="$PROJ/containers"
export APPTAINER_CACHEDIR="$PROJ/containers/.apptainer-cache"
