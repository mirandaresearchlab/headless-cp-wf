/*
 * Headless CellProfiler — Main Nextflow Configuration
 *
 * Shared workflow configuration.
 * Execution-specific settings are in nf-config/.
 *
 * Supported profiles:
 *   - local
 *   - berzelius
 */

manifest {
    name = 'headless-cellprofiler'
    version = '1.0.0'
    nextflowVersion = '>=25.10.4'
}


// --------------------------------------------------
// 1. WORKFLOW PARAMETERS
// --------------------------------------------------

params {
    // Input paths
    images = null
    configs = null
    project = null

    // Output directory
    // Results: <outdir>/projects/<project>/
    outdir = '.'

    // CellProfiler batching
    batch_size = 9

    // Default resources per task
    task_cpus = 1
    task_memory = '6 GB'
    task_time = '4h'

    // Local workstation resource budget
    total_cpus = 2
    total_memory = '16 GB'

    // Concurrency
    max_forks = 0
    max_jobs = 8

    // Storage overrides
    nf_work_dir = null
    conda_cache = null
    shared_dir = null

    // SLURM
    slurm_partition = 'berzelius-cpu'
    slurm_account = null

    // Retry policy
    max_retries = 1
}


// --------------------------------------------------
// 2. COMMON PROCESS SETTINGS
// --------------------------------------------------

process {
    cpus = params.task_cpus
    memory = params.task_memory
    time = params.task_time

    errorStrategy = 'terminate'

    shell = ['/bin/bash', '-euo', 'pipefail']
}


// --------------------------------------------------
// 3. ENVIRONMENT VARIABLES
// --------------------------------------------------

env {
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    NUMEXPR_NUM_THREADS = '1'
    VECLIB_MAXIMUM_THREADS = '1'

    MPLBACKEND = 'Agg'
    QT_QPA_PLATFORM = 'offscreen'
    PYTHONNOUSERSITE = '1'
}


// --------------------------------------------------
// 4. EXECUTION PROFILES
// --------------------------------------------------
// These profiles are used to configure the workflow for different execution environments. 
// Each profile can override parameters and settings defined above.
profiles {

    local {
        includeConfig 'nf-config/local.config'
    }

    berzelius {
        includeConfig 'nf-config/berzelius.config'
    }
}
