manifest {
    name            = 'cp-headless'
    description     = 'Headless, chunked CellProfiler: features + segmentation masks from a .cppipe and an image folder'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
}

params {
    // ---- required -----------------------------------------------------------
    pipeline           = null          // .cppipe / .cpproj
    input_dir          = null          // folder with images (searched recursively)

    // ---- outputs ------------------------------------------------------------
    outdir             = 'results'
    publish_mode       = 'copy'        // 'copy' survives `rm -rf work`; 'symlink'/'link' save space
    gzip_features      = false

    // ---- image discovery ----------------------------------------------------
    extensions         = 'tif,tiff,png,jpg,jpeg,bmp,c01,dib,flex,czi,nd2,lif,lsm,oib,oif,ims,zvi'

    // ---- parallelisation ----------------------------------------------------
    // chunk_size  = number of IMAGE SETS (sites/fields) per CellProfiler job; 0 = one job.
    // group_regex = regex on the path relative to input_dir; capture groups define the
    //               image set, so all channels of one site stay in the same chunk.
    //               e.g. '^(.+?)_w\\d' for "A01_s1_w1.tif / A01_s1_w2.tif"
    chunk_size         = 0
    group_regex        = null
    strict_image_count = false         // fail (not warn) if CellProfiler's image-set count != regex prediction

    // ---- masks --------------------------------------------------------------
    save_masks         = true
    mask_objects       = null          // e.g. 'Nuclei,Cells'; null = every object set in the pipeline
    mask_format        = 'tiff'        // tiff | png (16-bit) | npy (raw labels)
    allow_unpatched    = false         // if patching fails, run the original pipeline instead of stopping

    // ---- CellProfiler -------------------------------------------------------
    // Match the CellProfiler version your .cppipe was saved with (header line DateRevision: 428 -> 4.2.8).
    container          = 'cellprofiler/cellprofiler:4.2.8'
    plugins_dir        = null
    cellprofiler_args  = ''            // extra CLI args, e.g. '--conserve-memory True'

    // ---- resource caps (see process.resourceLimits) ---------------------------
    max_cpus           = 16
    max_memory         = '64.GB'
    max_time           = '48.h'
}

process {
    // Retry only on resource kills (OOM / walltime); real pipeline errors fail fast.
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] && task.attempt <= 3 ? 'retry' : 'terminate' }
    maxRetries    = 3

    withLabel: 'cellprofiler' {
        container = params.container
        cpus      = 1                                  // a CellProfiler job is single-threaded
        memory    = { 8.GB * task.attempt }
        time      = { 6.h * task.attempt }
    }
    withName: 'PATCH_PIPELINE' {                     // only loads/edits the .cppipe
        memory    = { 2.GB * task.attempt }
        time      = { 30.min * task.attempt }
    }
    withLabel: 'merge' {
        container = params.container                   // only needs python3 (stdlib)
        cpus      = 1
        memory    = { 4.GB * task.attempt }
        time      = { 2.h * task.attempt }
    }

    // Hard caps: requests (incl. retries) are clipped to these. SET THEM TO YOUR MACHINE/NODE,
    // otherwise the local executor refuses tasks that ask for more than the machine has.
    resourceLimits = [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time]
}

profiles {
    docker {
        docker.enabled    = true
        // The official image sets ENTRYPOINT ["cellprofiler"]; clear it so Nextflow can run bash.
        // Run as the calling user so outputs are not owned by root.
        docker.runOptions = '--entrypoint "" -u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
    local {
        // CellProfiler installed on PATH (e.g. conda env); no container.
        process.container = null
    }
    slurm {
        process.executor   = 'slurm'
        executor.queueSize = 50
        // process.queue          = 'normal'
        // process.clusterOptions = '--account=my_account'
    }
    test {
        params.pipeline   = "${projectDir}/tests/test.cppipe"
        params.input_dir  = "${projectDir}/tests/images"
        params.outdir     = 'results_test'
        params.chunk_size = 2
        params.group_regex = '^(.+)$'                   // single-channel: one file = one image set
        process.resourceLimits = [cpus: 2, memory: 3.GB, time: 1.h]
    }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = false }

// Make failures in piped commands visible.
process.shell = ['/bin/bash', '-euo', 'pipefail']
