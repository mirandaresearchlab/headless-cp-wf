/*
 * Headless CellProfiler: main configuration.
 *
 * All parameters are defined here, once. conf/base.config holds the process settings that every
 * profile shares. The profiles in conf/ hold only what differs between executors.
 */

manifest {
    name = 'headless-cellprofiler'
    version = '1.0.0'
    nextflowVersion = '>=25.10.4'
    mainScript = 'main.nf'
}

params {
    // Inputs: the samplesheet (one row per image file) and the folder with the two .cppipe files.
    input = null
    configs = null

    // Results go to <outdir>/projects/<project>/. Without --project, the session ID is the name.
    outdir = '.'
    project = null

    // Image sets per ANALYSIS task.
    batch_size = 9

    // Cellpose-SAM: only used if 2_analysis.cppipe has RunCellpose modules. SEGMENT runs them on
    // the CPU or on a GPU (cpu, gpu). One SEGMENT task segments segmentation_batches batches with
    // segmentation_workers CellProfiler processes at the same time (on a GPU, they share it).
    // segmentation_batches 0 means 16 on a GPU (keeps it busy) and 1 on CPUs (about 10x slower).
    segmentation = 'cpu'
    segmentation_batches = 0
    segmentation_workers = 4

    // Folder with the Cellpose-SAM model file 'cpsam'. Default: ~/.cellpose/models. A missing
    // file is downloaded once (1.2 GB) by the first SEGMENT task.
    cellpose_models = null

    // Resources of each task.
    task_cpus = 1
    task_memory = '6 GB'
    task_time = '4h'
    max_retries = 1

    // Local profile: the CPU and memory budget shared by all tasks, and an optional limit per process.
    total_cpus = 2
    total_memory = '16 GB'
    max_forks = 0

    // Berzelius profile: Slurm settings and the shared work folder.
    slurm_partition = 'berzelius-cpu'
    slurm_account = null
    max_jobs = 8
    shared_dir = null

    // Berzelius profile with --segmentation gpu: the GPU partition, the cores that come with one
    // GPU (16 on Ampere, 14 on Hopper), and the most SEGMENT tasks (GPUs) at the same time.
    gpu_partition = 'berzelius'
    gpu_cpus = 16
    max_gpus = 4

    // Work folder. Default: <launch folder>/work (local), <shared_dir>/nextflow-work (Berzelius).
    nf_work_dir = null
}

includeConfig 'conf/base.config'

// One thread per library call: each task gets task_cpus cores, and CellProfiler uses one.
env {
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    NUMEXPR_NUM_THREADS = '1'
    VECLIB_MAXIMUM_THREADS = '1'
    MPLBACKEND = 'Agg'
    QT_QPA_PLATFORM = 'offscreen'
    PYTHONNOUSERSITE = '1'

    // Empty means the Cellpose default folder, ~/.cellpose/models.
    CELLPOSE_LOCAL_MODELS_PATH = params.cellpose_models ?: ''
}

// Execution reports. With --project they go to <project>/report/, else to the launch folder.
// main.nf knows that a new project folder can already hold this report/ folder.
trace {
    enabled = true
    file = params.project ? "${params.outdir}/projects/${params.project}/report/trace.txt" : "${launchDir}/trace.txt"
    overwrite = true
    fields = ['task_id', 'hash', 'name', 'status', 'exit', 'cpus', 'memory', 'realtime', 'peak_rss', 'peak_vmem', 'read_bytes', 'write_bytes']
}
report {
    enabled = true
    file = params.project ? "${params.outdir}/projects/${params.project}/report/report.html" : "${launchDir}/report.html"
    overwrite = true
}
timeline {
    enabled = true
    file = params.project ? "${params.outdir}/projects/${params.project}/report/timeline.html" : "${launchDir}/timeline.html"
    overwrite = true
}

profiles {
    local {
        includeConfig 'conf/local.config'
    }
    berzelius {
        includeConfig 'conf/berzelius.config'
    }
}
